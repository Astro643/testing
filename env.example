DISCORD_TOKEN=

UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

CLOUDFLARE_ACCOUNT_ID=your_actual_cloudflare_account_id_string
CLOUDFLARE_API_KEY=your_actual_cloudflare_api_token
# Cloudflare's catalog lists this FP8 build of Llama 3.1 8B (32k context). The older plain
# @cf/meta/llama-3.1-8b-instruct has a documented deprecation date of 2026-05-30, so avoid it.
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# schema = request schema-checked JSON. If Cloudflare rejects it for your model, set this to off.
CLOUDFLARE_JSON_MODE=schema
AI_MAX_OUTPUT_TOKENS=400

# Optional tuning (values shown are the defaults)
HUMAN_TICKET_LIMIT=30
CLOSE_DELAY_SECONDS=15
MAX_USER_MESSAGES=20
DAILY_AI_LIMIT_PER_SERVER=300
MAX_KB_CHUNKS_PER_SERVER=500
