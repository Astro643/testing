DISCORD_TOKEN=

UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google AI Studio API key (aistudio.google.com > Get API key)
GEMINI_API_KEY=

# Optional (values shown are the defaults)
GEMINI_MODEL=gemini-3.5-flash-lite
# schema = request schema-checked JSON. If Google rejects it for your model, set this to off.
AI_JSON_MODE=schema
AI_MAX_OUTPUT_TOKENS=1024
CLOSE_DELAY_SECONDS=15
MAX_USER_MESSAGES=20
DAILY_AI_LIMIT_PER_SERVER=300
MAX_KB_CHUNKS_PER_SERVER=500
